rules_version = '2';
// O tenant e o papel são claims assinadas pelo Firebase Auth. O documento pai
// não concede permissões. Os tipos dos cadastros estão em src/types.ts.
// Links públicos, consentimento, filas, faturamento e eventos são criados pelo
// servidor. Os usuários finais chegam a eles por funções autenticadas ou links.
service cloud.firestore {
  match /databases/{database}/documents {
    match /tenants/{tenant}/{area}/{id} {
      function roleIn(roles) {
        return request.auth != null && request.auth.token.get('tenantId', '') == tenant
          && request.auth.token.get('role', '') in roles;
      }
      function manager() { return roleIn(['administrador_saas','administrador','gerente']); }
      function serviceDesk() { return manager() || roleIn(['operador','atendimento']); }
      function text(v, n) { return v is string && v.size() <= n; }
      function named(v) { return text(v, 160) && v.size() > 0; }
      function records(v, n) { return v is list && v.size() <= n; }
      function price(v) { return v is number && v >= 0 && v <= 1000000; }
      function stamp(d) {
        return text(d.createdAt, 40) && text(d.get('updatedAt',''), 40);
      }
      function menu(d) {
        return d.keys().hasOnly(['id','name','description','imageBanner','availableHours','active','productIds','createdAt','acceptOrders'])
          && named(d.name) && text(d.description, 4000) && text(d.imageBanner, 4096)
          && text(d.availableHours, 300) && d.active is bool && d.get('acceptOrders',true) is bool
          && records(d.productIds, 250) && stamp(d);
      }
      function product(d) {
        return d.keys().hasOnly(['id','name','description','image','category','price','tamanhos','adicionais','naoMandar','utensilios','available'])
          && named(d.name) && text(d.description, 4000) && text(d.image, 4096) && text(d.category, 100)
          && price(d.price) && records(d.tamanhos, 50) && records(d.adicionais, 100)
          && records(d.naoMandar, 100) && records(d.utensilios, 50) && d.get('available',true) is bool;
      }
      function segment(d) {
        return d.keys().hasOnly(['id','name','description','active','createdAt','updatedAt'])
          && named(d.name) && text(d.description, 2000) && d.active is bool && stamp(d);
      }
      function template(d) {
        return d.keys().hasOnly(['id','name','category','message','active','createdAt','updatedAt'])
          && named(d.name) && text(d.category, 160) && text(d.message, 4096) && d.active is bool && stamp(d);
      }
      function campaign(d) {
        return d.keys().hasOnly(['id','name','messageTemplate','sentCount','responseCount','status','createdAt','lastRun','channel','segmentId','templateId','updatedAt'])
          && named(d.name) && text(d.messageTemplate, 4096) && stamp(d)
          && d.status in ['rascunho','ativo','concluido','pausado'] && d.sentCount is int && d.responseCount is int
          && d.get('channel','whatsapp') in ['whatsapp','rcs','ambos']
          && text(d.get('segmentId',''),128) && text(d.get('templateId',''),128);
      }
      function schedule(d) {
        return d.keys().hasOnly(['id','campaignId','date','time','status','createdAt','updatedAt'])
          && text(d.campaignId, 128) && d.campaignId.matches('^[A-Za-z0-9_-]+$')
          && exists(/databases/$(database)/documents/tenants/$(tenant)/campaigns/$(d.campaignId))
          && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.time.matches('^[0-9]{2}:[0-9]{2}$')
          && d.status in ['agendado','pausado','cancelado'] && stamp(d);
      }
      function courier(d) {
        return d.keys().hasOnly(['id','name','phone','cpf','vehicle','plate','photo','vehicleType','status','activeOrders','rating','avgDeliveryTime','lastLocation'])
          && named(d.name) && text(d.phone, 32) && text(d.cpf, 20) && text(d.vehicle, 128)
          && text(d.plate, 32) && text(d.photo, 4096) && d.vehicleType in ['moto','carro','bicicleta']
          && d.status in ['Disponível','Em entrega','Pausado','Offline','AVAILABLE','ON_DELIVERY','SLOW','OFFLINE']
          && records(d.activeOrders, 100) && d.rating is number && d.rating >= 0 && d.rating <= 5
          && text(d.avgDeliveryTime, 32) && d.lastLocation.keys().hasOnly(['lat','lng','address'])
          && d.lastLocation.lat is number && d.lastLocation.lat >= -90 && d.lastLocation.lat <= 90
          && d.lastLocation.lng is number && d.lastLocation.lng >= -180 && d.lastLocation.lng <= 180
          && text(d.lastLocation.address, 400);
      }
      function catalogOrMarketing(d) {
        return d.id == id && ((area == 'productsDigitalMenu' && product(d))
          || (area == 'cardapios' && menu(d))
          || (area == 'campaignTemplates' && template(d))
          || (area == 'commercialSegments' && segment(d))
          || (area == 'campaignSchedules' && schedule(d)));
      }
      function settings(d) {
        return area == 'settings' && id == 'default'
          && d.keys().hasOnly(['restaurant','operation','delivery','cashier','whatsapp','dispatcher','ui','dailyLimit','intervalMin','intervalMax','autoPause','autoPauseAfter','waSessionStatus','operatorRole','operatorName','theme'])
          && d.restaurant is map && named(d.restaurant.name)
          && d.operation is map && d.operation.isOpen is bool && d.operation.acceptPublicOrders is bool
          && d.delivery is map && price(d.delivery.defaultFee)
          && d.cashier is map && d.whatsapp is map && d.dispatcher is map && d.ui is map
          && d.theme in ['light','dark'] && d.dailyLimit is int && d.dailyLimit >= 0
          && d.intervalMin >= 0 && d.intervalMax >= d.intervalMin && d.autoPause is bool;
      }
      function profile(d) {
        return d.id == id && named(d.name) && text(d.phone, 32) && records(d.tags,64)
          && records(d.notes,128) && text(d.avatarColor,120) && text(d.get('avatar',''),4096)
          && d.type in ['salvo','nao_salvo','grupo','bloqueado']
          && d.stage in ['Rascunho','Lead','Em atendimento','Pedido gerado','Aguardando pagamento','Pago','Produção','Entregue','Fechado','Pós-venda'];
      }
      allow read: if
        (area in ['settings','productsDigitalMenu','cardapios'] &&
          roleIn(['administrador_saas','administrador','gerente','operador','atendimento','caixa','cozinha']))
        || (area in ['clients','messages','history','campaigns','commercialSegments','campaignTemplates','campaignSchedules','campaignResults','automations'] && serviceDesk())
        || (area in ['orders','deliveryOrders'] && (serviceDesk() || roleIn(['caixa'])))
        || (area == 'caixaSessions' && (manager() || roleIn(['caixa'])))
        || (area in ['couriers','routes','reviews','deliveryHistories'] && manager());

      allow create: if manager() && (
        settings(request.resource.data) || catalogOrMarketing(request.resource.data)
        || (area == 'campaigns' && request.resource.data.id == id && campaign(request.resource.data)
          && request.resource.data.status == 'rascunho' && request.resource.data.sentCount == 0
          && request.resource.data.responseCount == 0 && !('lastRun' in request.resource.data))
        || (area == 'couriers' && request.resource.data.id == id && courier(request.resource.data)
          && request.resource.data.activeOrders.size() == 0 && request.resource.data.status in ['Disponível','AVAILABLE']));

      allow update: if manager() && (
        settings(request.resource.data)
        || (catalogOrMarketing(request.resource.data) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt','campaignId']))
        || (area == 'campaigns' && request.resource.data.id == id && campaign(request.resource.data)
          && resource.data.status == 'rascunho'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','messageTemplate','channel','segmentId','templateId','updatedAt']))
        || (area == 'couriers' && request.resource.data.id == id && courier(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','vehicle','plate','photo','cpf','vehicleType'])));

      allow update: if area == 'clients' && serviceDesk() && profile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','avatar','avatarColor','tags','notes','type','stage'])
        && (request.resource.data.stage == resource.data.stage ||
          (request.resource.data.stage in ['Rascunho','Lead','Em atendimento'] && resource.data.stage in ['Rascunho','Lead','Em atendimento']));

      allow delete: if manager() && (area in ['commercialSegments','campaignTemplates'] ||
        (area == 'campaigns' && resource.data.status == 'rascunho') ||
        (area == 'campaignSchedules' && resource.data.status in ['agendado','pausado','cancelado']));
    }
    // Não há regra de escrita pelo cliente para pagamentos, pedidos, crédito,
    // caixa, membros, evidências, links e outbox. O Admin SDK usa IAM próprio.
  }
}
